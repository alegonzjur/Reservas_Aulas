# Copia este fichero como ".env" y rellena los valores. El fichero ".env" NO se sube a git.

# --- Django ---
# Genera una clave larga y aleatoria, por ejemplo:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# En producción debe ser False. Con True se muestran páginas de error detalladas.
DJANGO_DEBUG=False
# Nombres o IPs con los que se accederá a la web, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,reservas.centro.local
# Necesario si accedes por un nombre/puerto distinto (incluye el esquema), separados por comas.
DJANGO_CSRF_TRUSTED_ORIGINS=http://reservas.centro.local
# Pon True solo si sirves la web por HTTPS.
DJANGO_COOKIES_SEGURAS=False

# --- Base de datos PostgreSQL ---
DB_NAME=reservas_aulas
DB_USER=reservas
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432

# --- Correo ---
# Para desarrollo puedes usar: django.core.mail.backends.console.EmailBackend (escribe el correo en la consola)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.centro.local
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Cuenta genérica que actúa como emisor
EMAIL_HOST_USER=reservas@centro.local
EMAIL_HOST_PASSWORD=cambia-esto
DEFAULT_FROM_EMAIL=Reservas de aulas <reservas@centro.local>
# Receptores del aviso de nueva petición (uno o varios, separados por comas)
RESERVAS_EMAIL_DESTINO=mantenimiento@centro.local

# --- Aplicación ---
# URL base con la que se llega a la web desde la red del centro (se usa en el enlace del correo)
SITE_URL=http://reservas.centro.local
